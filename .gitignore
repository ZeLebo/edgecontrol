# Publish only the application sources, tests, source assets, and build tools.
/*
!/.gitignore
!/Package.swift
!/README.md
!/CHANGELOG.md
!/Sources/
/Sources/*
!/Sources/EdgeControl/
/Sources/EdgeControl/*
!/Sources/EdgeControl/*.swift
!/Tests/
/Tests/*
!/Tests/EdgeControlTests/
/Tests/EdgeControlTests/*
!/Tests/EdgeControlTests/*.swift
!/Resources/
/Resources/*
!/Resources/Info.plist
!/Resources/EdgeControlIcon.png
!/scripts/
/scripts/*
!/scripts/build-app.sh
!/scripts/build-icon.swift
!/scripts/audit-public-tree.py
!/scripts/release.sh

# Local/generated files stay private even when created under a source folder.
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.mobileprovision
**/*.xcuserstate
**/xcuserdata/
**/.agents/
**/.codex/
**/.claude/
**/AGENTS.md
**/CLAUDE.md
**/build/
**/.build/
**/dist/
**/packages/
